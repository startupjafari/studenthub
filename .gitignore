# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Env / secrets
.env
.env.*
!.env.example

# Prisma
prisma/**/*.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage / test artifacts
coverage/
playwright-report/
test-results/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Playwright e2e (13.4): артефакты прогона и сохранённые сессии ролей
apps/web/e2e/.auth/
apps/web/test-results/
apps/web/playwright-report/
apps/web/.next-e2e/

# e2e-сборка api (отдельный outDir)
apps/api/dist-e2e/

# Прод-сборка веба в отдельный каталог (NEXT_DIST_DIR=.next-build), чтобы не затирать
# .next у работающего dev-сервера.
apps/web/.next-build/

# Исходная выгрузка КАТО (~4.7 МБ). В git едет только сгенерированный prisma/data/kato.json;
# пересборка — node scripts/gen-kato.mjs <выгрузка>
kato_*.json

# Артефакты UI-аудита (apps/web/e2e/ui-audit): скриншоты и отчёты прогона. Локальные —
# каждый прогон переписывает их целиком, а latest.md меняется полностью при каждом запуске.
ui-audit/screenshots/
ui-audit/reports/

# Кэш медиа для сида (prisma/seed/steps/10-media.mjs): скачанные фото и видео.
.seed-media/
