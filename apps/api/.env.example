NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

DATABASE_URL=postgresql://postgres:password@localhost:5432/studenthub
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/studenthub_test

JWT_ACCESS_SECRET=          # минимум 32 символа, без значения по умолчанию
JWT_REFRESH_SECRET=
TOTP_ENCRYPTION_KEY=       # минимум 32 символа, ключ шифрования 2FA-секретов (AES-256-GCM)
TWO_FACTOR_ENFORCE=true    # форс 2FA для привилегированных ролей; false — аварийно отключить
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_POSTS=posts-media
MINIO_BUCKET_STORIES=stories-media
MINIO_BUCKET_APPLICATIONS=applications
MINIO_BUCKET_PROFILE_MEDIA=profile-media
MINIO_BUCKET_DOCUMENTS=documents

# Для локальной разработки поднимите Mailpit (docker compose up -d mailpit) и укажите
# SMTP_HOST=localhost, SMTP_PORT=1025 — письма будут видны на http://localhost:8025.
# Пусто → jsonTransport: письма не отправляются, только логируются.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StudentHub <noreply@studenthub.app>"

CORS_ORIGIN=http://localhost:3000
THROTTLE_TTL=900
THROTTLE_LIMIT=5
SENTRY_DSN=

# Web Push (Ф13.3): сгенерировать `pnpm --filter api exec web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Публичный адрес MinIO (presigned-ссылки отдаются браузеру) и бакеты, добавленные
# после первой редакции файла.
# Пусто — presigned-ссылки идут на MINIO_ENDPOINT (локальная разработка).
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true
MINIO_BUCKET_CHAT=chat-media
MINIO_BUCKET_MATERIALS=materials
MINIO_BUCKET_PROFILE_COVERS=profile-covers

# Окно грации при повторе ротированного refresh-токена, мс (BACKEND_RULES §6.2).
# 0 — строгое поведение: любой повтор рвёт цепочку.
REFRESH_REUSE_GRACE_MS=10000
