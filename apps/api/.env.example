NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

DATABASE_URL=postgresql://postgres:password@localhost:5432/studenthub
DATABASE_URL_TEST=postgresql://postgres:password@localhost:5432/studenthub_test

JWT_ACCESS_SECRET=          # минимум 32 символа, без значения по умолчанию
JWT_REFRESH_SECRET=
TOTP_ENCRYPTION_KEY=       # минимум 32 символа, ключ шифрования 2FA-секретов (AES-256-GCM)
TWO_FACTOR_ENFORCE=true    # форс 2FA для привилегированных ролей; false — аварийно отключить
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_AVATARS=avatars
MINIO_BUCKET_POSTS=posts-media
MINIO_BUCKET_STORIES=stories-media
MINIO_BUCKET_APPLICATIONS=applications
MINIO_BUCKET_PROFILE_MEDIA=profile-media
MINIO_BUCKET_DOCUMENTS=documents

# Для локальной разработки поднимите Mailpit (docker compose up -d mailpit) и укажите
# SMTP_HOST=localhost, SMTP_PORT=1025 — письма будут видны на http://localhost:8025.
# Пусто → jsonTransport: письма не отправляются, только логируются.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StudentHub <noreply@studenthub.app>"

CORS_ORIGIN=http://localhost:3000

# Кому верить в X-Forwarded-* (реальный IP клиента для лимитов входа и аудита).
# Адреса/CIDR или пресеты @fastify/proxy-addr через запятую; false — прокси нет.
# По умолчанию приватные сети: nginx из docker-сети и edge Railway попадают, запрос
# с публичного адреса — нет, и подделать свой IP не может. true не принимается.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Брендирование выгружаемых документов.
# APP_PUBLIC_URL уходит внутрь файлов (колонтитул, ссылка проверки) — на проде это
# постоянный домен, а не адрес стенда. Пусто — берётся первый origin из CORS_ORIGIN.
BRAND_NAME=StudentHub
APP_PUBLIC_URL=
THROTTLE_TTL=900
THROTTLE_LIMIT=5

# Мониторинг ошибок (Ф13.8). Пусто = Sentry не инициализируется (так работают dev и тесты).
SENTRY_DSN=
# Имя окружения в Sentry (production/staging/pilot). По умолчанию — NODE_ENV.
SENTRY_ENVIRONMENT=
# Версия сборки (обычно git sha) — для группировки релизов.
SENTRY_RELEASE=
# Доля запросов в трейсинг производительности. 0 = только ошибки (по умолчанию).
SENTRY_TRACES_SAMPLE_RATE=0

# Токен бота админского мини-аппа в Telegram: им проверяется подпись initData.
# Пусто — мини-апп выключен (/mini/session отвечает «нет доступа»).
TELEGRAM_BOT_TOKEN=
# Адрес мини-аппа для кнопки в уведомлении (без него уведомление уходит без кнопки)
MINI_APP_URL=

# Пуши на iPhone (APNs). Пусто — отправка на устройства молчит.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=kz.studenthub.app
# Содержимое .p8 одной строкой, переводы строк как \n
APNS_PRIVATE_KEY=
# true для TestFlight и App Store, false для сборок из Xcode
APNS_PRODUCTION=false

# Пуши на Android (FCM). Три поля из JSON сервисного аккаунта Firebase:
# Project settings → Service accounts → Generate new private key.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# private_key одной строкой, переводы строк как \n
FCM_PRIVATE_KEY=

# Минимальная поддерживаемая версия приложения для iPhone. Ниже неё приложение
# показывает экран обновления. 0.0.0 — никого не блокируем (значение по умолчанию).
IOS_MIN_SUPPORTED_VERSION=0.0.0
# Ссылка на приложение в App Store для кнопки «Обновить». Пусто — кнопки не будет.
IOS_STORE_URL=
# То же для Android: своя планка, свой магазин.
ANDROID_MIN_SUPPORTED_VERSION=0.0.0
# Ссылка на приложение в Google Play. Пусто — кнопки не будет.
ANDROID_STORE_URL=

# Web Push (Ф13.3): сгенерировать `pnpm --filter api exec web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Публичный адрес MinIO (presigned-ссылки отдаются браузеру) и бакеты, добавленные
# после первой редакции файла.
# Пусто — presigned-ссылки идут на MINIO_ENDPOINT (локальная разработка).
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true
MINIO_BUCKET_CHAT=chat-media
MINIO_BUCKET_MATERIALS=materials
MINIO_BUCKET_PROFILE_COVERS=profile-covers

# Окно грации при повторе ротированного refresh-токена, мс (BACKEND_RULES §6.2).
# 0 — строгое поведение: любой повтор рвёт цепочку.
REFRESH_REUSE_GRACE_MS=10000


# Единая медиа-система (docs/PROJECT.md «Медиа»): варианты изображений, LQIP, постеры и HLS.
# inline — обработка в процессе API (dev); worker — только постановка задач, обрабатывает
# `node dist/worker.js` (на проде отдельный сервис studenthub-worker с тем же образом).
MEDIA_PROCESSING=inline
MEDIA_IMAGE_CONCURRENCY=2
MEDIA_VIDEO_CONCURRENCY=1
# Бинарники ffmpeg/ffprobe. Без них видео остаются без HLS и проигрываются оригиналом.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Каталог временных файлов перекодирования; пусто — системный tmp.
MEDIA_TMP_DIR=
# Секрет токенов HLS-плейлистов (≥ 32 символов); пусто — выводится из JWT_ACCESS_SECRET.
MEDIA_TOKEN_SECRET=

# Сторисы на сервере. false — API сторис закрыт (лента пустая, остальные ручки 404);
# пара к NEXT_PUBLIC_FEATURE_STORIES у веба. По умолчанию true — как до флага.
FEATURE_STORIES=true

# Крон purgeUnverifiedEmployers: удалять компании, не подтвердившие почту за 30 дней, вместе с
# аккаунтами участников. Удаление данных — по умолчанию выключено.
CLEANUP_PURGE_UNVERIFIED_EMPLOYERS=false

# Медиа-ретранслятор камер (docs/PROJECT.md §3.10, docker/media-relay/README.md).
# Пусто — просмотр камер выключен. Ключ: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
MEDIA_JWT_PRIVATE_KEY=
MEDIA_RELAY_HLS_URL=
MEDIA_RELAY_PUBLISH_URL=
MEDIA_RELAY_CA_PEM=
