{
  "sourceLanguage": "ru",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы снять фото или видео для истории, сфотографировать или отсканировать документ для чата, сфотографироваться для профиля и отсканировать QR-код входа на компьютере."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тарихқа фото не бейне түсіру, чатқа құжатты суретке түсіру не сканерлеу, профильге суретке түсу және компьютерге кіру QR-кодын сканерлеу үшін."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы записать голосовое сообщение или видео для истории со звуком."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дауыстық хабар не тарихқа дыбысты бейне жазу үшін."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сохранить фото и видео из приложения в «Фото»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қолданбадағы фото мен бейнені «Фото»-ға сақтау үшін."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы показать недавние фото и видео при отправке в чат и при создании истории."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чатқа жіберу және тарих жасау кезінде соңғы фото мен бейнелерді көрсету үшін."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы отправить своё местоположение в чат или транслировать его, пока вы сами не остановите трансляцию."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чатқа орныңызды жіберу немесе трансляцияны өзіңіз тоқтатқанша оны тарату үшін."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы подключиться к серверу разработки на компьютере."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Компьютердегі әзірлеу серверіне қосылу үшін."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы выбрать контакт и отправить его карточку в чат."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контактіні таңдап, оның карточкасын чатқа жіберу үшін."
          }
        }
      }
    }
  },
  "version": "1.0"
}
