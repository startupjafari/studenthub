          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Семестр ашыңыз"
          }
        }
      }
    },
    "uadmin.setup.short.subjects": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
