      }
    },
    "teaching.schedule.changes.footer": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенос, отмену и замену занятия оформляет деканат — обратитесь туда, если нужно разовое изменение."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабақты ауыстыруды, болдырмауды және алмастыруды деканат рәсімдейді — бір реттік өзгеріс қажет болса, деканатқа хабарласыңыз."
          }
        }
      }
    },
