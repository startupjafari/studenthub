    "librarian.import.hint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Таблица CSV или Excel: первая строка — заголовки. Обязательна колонка «Название»; ещё можно «Авторы», «ISBN», «Издательство», «Год», «Раздел», «Инвентарный номер» (несколько — через запятую) или «Количество»."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV немесе Excel кестесі: бірінші жол — тақырыптар. «Атауы» бағаны міндетті; сондай-ақ «Авторлар», «ISBN», «Баспа», «Жыл», «Бөлім», «Түгендеу нөмірі» (бірнешеуі — үтір арқылы) немесе «Саны» болуы мүмкін."
          }
        }
      }
    },
