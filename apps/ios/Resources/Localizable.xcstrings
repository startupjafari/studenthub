    "uadmin.setup.needFaculties": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала заведите хотя бы один факультет — группа привязывается к нему."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Алдымен кемінде бір факультет ашыңыз — топ соған байланады."
          }
        }
      }
    },
