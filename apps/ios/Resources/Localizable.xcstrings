    "starosta.documents.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто из группы уже сдал комплект по запросам университета. Сами документы здесь не видны"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Топтан кім университет сұраулары бойынша жиынтықты тапсырды. Құжаттардың өзі мұнда көрінбейді"
