    "staff.tpl.issue.syntax": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В документе обнаружена ошибка в переменной%@. Проверьте фигурные скобки и повторите загрузку."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжаттағы айнымалыда қате табылды%@. Фигуралы жақшаларды тексеріп, қайта жүктеңіз."
          }
        }
      }
    },
    "staff.tpl.issue.unknown": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переменная %@%@ не поддерживается StudentHub. Проверьте написание по каталогу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ айнымалысын StudentHub қолдамайды. Жазылуын каталог бойынша тексеріңіз."
          }
        }
      }
    },
    "staff.tpl.issue.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конструкция %@ пока не поддерживается: используйте только простые переменные из каталога."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ құрылымы әзірге қолдау таппайды: каталогтағы қарапайым айнымалыларды ғана пайдаланыңыз."
          }
        }
      }
    },
    "staff.tpl.issue.tooMany": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В документе слишком много переменных — не больше 500."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжатта айнымалылар тым көп — 500-ден аспауы керек."
          }
        }
      }
    },
    "staff.tpl.issue.noVariables": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В документе нет ни одной переменной — он будет выдаваться без изменений."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжатта бірде-бір айнымалы жоқ — ол өзгеріссіз беріледі."
          }
        }
      }
    },
    "staff.tpl.issue.optional": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поле «%@» бывает не заполнено — тогда на его месте останется пусто."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» өрісі толтырылмауы мүмкін — онда оның орны бос қалады."
          }
        }
      }
    },
    "staff.tpl.issue.personal": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблон подставляет персональные данные студента. Выдавайте документ только по запросу."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Үлгі студенттің дербес деректерін қояды. Құжатты тек сұрау бойынша беріңіз."
          }
        }
      }
    },
    "staff.tpl.issue.more": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "И ещё несколько похожих ошибок (%@) — исправьте перечисленные и загрузите файл снова."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тағы бірнеше ұқсас қате бар (%@) — аталғандарын түзетіп, файлды қайта жүктеңіз."
          }
        }
      }
    },
    "staff.tpl.file.corrupted": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл повреждён и не открывается. Сохраните документ в Word заново и загрузите ещё раз."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл зақымдалған және ашылмайды. Құжатты Word-та қайта сақтап, тағы жүктеңіз."
          }
        }
      }
    },
    "staff.tpl.file.notWord": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не документ Word. Сохраните файл в формате .docx."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бұл Word құжаты емес. Файлды .docx пішімінде сақтаңыз."
          }
        }
      }
    },
    "staff.tpl.file.macros": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В документе есть макросы. Сохраните его как обычный документ Word (.docx) без макросов."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжатта макростар бар. Оны макроссыз кәдімгі Word құжаты (.docx) ретінде сақтаңыз."
          }
        }
      }
    },
    "staff.tpl.file.active": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В документе есть встроенные объекты или элементы управления. Удалите их и загрузите файл снова."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжатта кірістірілген нысандар немесе басқару элементтері бар. Оларды жойып, файлды қайта жүктеңіз."
          }
        }
      }
    },
    "staff.tpl.file.external": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Документ ссылается на внешний шаблон или файл. Отключите связь и сохраните документ заново."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Құжат сыртқы үлгіге немесе файлға сілтейді. Байланысты өшіріп, құжатты қайта сақтаңыз."
          }
        }
      }
    },
    "staff.tpl.file.encrypted": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
