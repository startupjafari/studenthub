    "career.apply.hiddenText": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компания получит отклик с вашим именем, специальностью и навыками, но не увидит карьерный профиль: о себе, что вы ищете, портфолио."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Компания өтінімді атыңызбен, мамандығыңызбен және дағдыларыңызбен алады, бірақ мансаптық профиліңізді көрмейді: өзіңіз туралы, не іздейтініңіз, портфолио."
          }
        }
      }
    },
    "career.apply.share": {
      "extractionState": "manual",
