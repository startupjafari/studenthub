    "uadmin.dash.breakdownHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прогулы, опоздания и уважительные раздельно: за одним процентом это разные проблемы"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Себепсіз, кешігу және дәлелді себеп бөлек: бір пайыздың артында әртүрлі мәселе"
          }
        }
      }
    },
