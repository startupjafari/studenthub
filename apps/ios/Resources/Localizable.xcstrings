    "uadmin.cameras.camerasEmpty": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камер пока нет. Добавьте камеру: адрес её потока в сети вуза и, если нужно, логин и пароль."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камералар әзірге жоқ. Камера қосыңыз: оның ЖОО желісіндегі ағын мекенжайы және қажет болса, логин мен құпиясөз."
          }
        }
