    "staff.tpl.delete.archivesHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По шаблону уже выдавали документы, поэтому он уйдёт в архив: формировать документы станет нельзя, а история сохранится."
