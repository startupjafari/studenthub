    "librarian.lostDesc": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» у читателя %@ будет отмечена утерянной, экземпляр выйдет из оборота. Долг останется за читателем, пока книгу не заменят или не возместят."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ оқырманындағы «%1$@» жоғалған деп белгіленеді, дана айналымнан шығады. Кітап ауыстырылмайынша немесе өтелмейінше қарыз оқырманда қалады."
          }
        }
      }
    },
    "librarian.settleDesc": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читатель %@ заменил «%@» или возместил её стоимость. Справка, выдача и брони снова откроются для него."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ оқырманы «%@» кітабын ауыстырды немесе құнын өтеді. Анықтама, кітап алу және брондар оған қайта ашылады."
          }
        }
      }
    },
