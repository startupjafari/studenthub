    },
    "uadmin.dash.trendHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Три факультета с худшей посещаемостью, по неделям семестра"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Қатысуы ең төмен үш факультет, семестр апталары бойынша"
