    },
    "uadmin.dash.trend": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Динамика посещаемости"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабаққа қатысу динамикасы"
          }
        }
