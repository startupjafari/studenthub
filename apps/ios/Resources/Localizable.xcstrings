    "chats.delete.selected.title": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить выбранные чаты?"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Таңдалған чаттарды жою керек пе?"
          }
        }
      }
    },
    "chats.delete.selected": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить и покинуть"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жою және шығу"
          }
        }
      }
    },
    "chats.delete.selected.message": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личные чаты удалятся у вас, из групп вы выйдете."
          }
        },
        "kk": {
          "stringUnit": {
