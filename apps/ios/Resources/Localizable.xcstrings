    "uadmin.dash.byGroupHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Худшие группы вуза — им нужно внимание в первую очередь"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ең төмен көрсеткішті топтар — оларға бірінші кезекте назар қажет"
          }
        }
      }
    },
    "uadmin.dash.noAttendance": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посещаемость ещё не отмечали"
          }
        },
        "kk": {
