      }
    },
    "uadmin.cameras.moduleHint": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенты в сети вуза, камеры за ними и выключатель модуля. Смотрят камеры только охрана и администратор вуза."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Университет желісіндегі агенттер, олардың камералары және модуль қосқышы. Камераларды тек күзет пен университет әкімшісі көреді."
          }
        }
      }
    },
    "uadmin.cameras.agentsEmpty": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Агентов пока нет. Добавьте агента и установите его на сервер в сети, где находятся камеры."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Агенттер әзірге жоқ. Агент қосып, оны камералар орналасқан желідегі серверге орнатыңыз."
          }
        }
      }
    },
