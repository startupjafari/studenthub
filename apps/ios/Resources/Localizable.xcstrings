    "uadmin.cameras.disableConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить камеры? Все просмотры прервутся сразу, новые станут недоступны."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камераларды өшіру керек пе? Барлық қарау бірден үзіледі, жаңалары қолжетімсіз болады."
          }
        }
      }
    },
    "uadmin.cameras.disable": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключить камеры"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камераларды өшіру"
          }
        }
      }
    },
    "uadmin.cameras.rotateConfirm": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевыпустить токен агента «%@»? Прежний перестанет работать сразу, пароли его камер придётся ввести заново."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» агентінің токенін қайта шығару керек пе? Бұрынғысы бірден жұмыс істемей қалады, оның камераларының құпиясөздерін қайта енгізу керек болады."
          }
        }
      }
    },
    "uadmin.cameras.rotate": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
