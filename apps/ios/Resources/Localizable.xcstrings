    "uadmin.dash.setupTitle": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка вуза не закончена"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оқу орнын баптау аяқталмаған"
          }
        }
      }
    },
    "uadmin.dash.setupText": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдено %@ из %@ шагов. Пока вуз не запущен, платформа закрыта даже для приглашённых."
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ қадамның %1$@ қадамы өтілді. Оқу орны іске қосылмайынша, платформа тіпті шақырылғандар үшін де жабық."
          }
        }
      }
    },
    "uadmin.dash.setupAction": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжить"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалғастыру"
          }
        }
      }
    },
    "uadmin.dash.byGroup": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посещаемость по группам"
          }
        },
        "kk": {
