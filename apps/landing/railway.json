{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/landing/Dockerfile"
  },
  "deploy": {
    "startCommand": "HOSTNAME=0.0.0.0 node apps/landing/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
