# Адрес API. В разработке НЕ нужен: dev-сервер проксирует /api на localhost:3001,
# и запросы идут тем же origin'ом, что и страница (см. vite.config.ts).
#
# Задавать здесь имеет смысл только для сборки, которую раздают отдельно от API.
# VITE_API_URL=https://api.studenthub.kz/api/v1

# Куда проксировать /api в разработке, если API поднят не на localhost:3001.
# MINI_APP_API_TARGET=http://localhost:3001
