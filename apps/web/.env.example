NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXT_PUBLIC_APP_NAME=StudentHub
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Публичный VAPID-ключ для подписки на web-push (совпадает с VAPID_PUBLIC_KEY api)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Мониторинг ошибок (Ф13.8). Пусто = Sentry выключен, ничего не отправляется.
# DSN публичный (только принимает события), поэтому NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Версия сборки (обычно git sha) — нужна, чтобы стектрейс сошёлся с source maps.
NEXT_PUBLIC_SENTRY_RELEASE=
# Доля запросов в трейсинг производительности. 0 = только ошибки (по умолчанию).
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Только для сборки: загрузка source maps в Sentry. Без токена шаг молча пропускается.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
