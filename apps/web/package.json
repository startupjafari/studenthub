{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=12288 next dev -p 3000",
    "build": "NODE_OPTIONS=--max-old-space-size=12288 next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo",
    "test": "vitest run",
    "test:cov": "NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "node e2e/prepare-db.mjs && playwright test --project=chromium",
    "e2e:ui": "node e2e/prepare-db.mjs && playwright test --project=chromium --ui",
    "ui-audit": "node e2e/prepare-db.mjs && playwright test --project=ui-audit",
    "size": "size-limit"
  },
