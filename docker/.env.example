# Инфраструктурный стек StudentHub (postgres, redis, minio).
# Скопируй в docker/.env и заполни секреты. Значения секретов НЕ коммитятся.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=studenthub
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# MinIO
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Порты приложений (используются на следующих фазах)
API_PORT=3001
WEB_PORT=3000
MINIO_BUCKET_MATERIALS=materials
MINIO_BUCKET_CHAT=chat-media
