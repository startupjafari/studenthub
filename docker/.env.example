# Переменные окружения инфраструктуры StudentHub.
# Скопируй в docker/.env и заполни. Значения секретов НЕ коммитятся (.gitignore).
#
# Файл читают оба стека:
#   docker-compose.yml       — инфраструктура для разработки; нужна только секция ниже
#   docker-compose.prod.yml  — прод-стек: подставляет домены и адреса сборки, а сервису api
#                              отдаёт ЭТОТ ЖЕ файл целиком как env_file

# ══════════════════════════ Разработка ══════════════════════════

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=studenthub
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# MinIO. Пароль — минимум 8 символов, иначе сервис не стартует.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit — локальный SMTP-приёмник: письма наружу не уходят, их видно на http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ══════════════════════════ Прод-стек ══════════════════════════
# Всё ниже нужно только для docker-compose.prod.yml. Порядок первого запуска и выпуск
# сертификата — docs/RUNBOOK.md, «Прод-стек: первый запуск и сертификаты».
#
# Сервис api получает этот файл как env_file, поэтому сюда же дописываются переменные
# приложения из apps/api/.env.example (JWT, SMTP, Sentry, APNs, VAPID, Telegram …).
# Без значения по умолчанию, то есть обязательные: DATABASE_URL, JWT_ACCESS_SECRET,
# JWT_REFRESH_SECRET, TOTP_ENCRYPTION_KEY, MINIO_ACCESS_KEY, MINIO_SECRET_KEY.

# Домены. Все четыре имени должны вести A-записями на машину со стеком. Сертификат
# выпускается один на все; первым -d идёт SH_DOMAIN — по нему же nginx собирает путь
# к файлам сертификата.
SH_DOMAIN=studenthub.kz
SH_APP_DOMAIN=app.studenthub.kz
SH_FILES_DOMAIN=files.studenthub.kz
SH_MINI_DOMAIN=mini.studenthub.kz

# Адрес для разовой команды выпуска сертификата (docs/RUNBOOK.md); compose его не читает.
CERTBOT_EMAIL=

# Адреса сервисов — имена контейнеров в сети compose, не localhost.
DATABASE_URL=postgresql://postgres:<пароль>@postgres:5432/studenthub
REDIS_HOST=redis
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false

# Ключи доступа api к хранилищу. Должны совпадать с MINIO_ROOT_USER/MINIO_ROOT_PASSWORD
# выше (или быть отдельной учётной записью MinIO с доступом к бакетам).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Публичный адрес хранилища: на него api подписывает ссылки, которые открывает браузер.
# Внутреннее имя `minio` снаружи не резолвится, поэтому без этих трёх строк загрузка
# и скачивание файлов в проде не работают.
MINIO_PUBLIC_ENDPOINT=files.studenthub.kz
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# Приложение
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://app.studenthub.kz
APP_PUBLIC_URL=https://app.studenthub.kz
# nginx стоит в сети docker — её адреса попадают в uniquelocal, иначе api будет считать
# клиентом сам прокси.
TRUST_PROXY=loopback, linklocal, uniquelocal

# Сборка web и лендинга. NEXT_PUBLIC_* инлайнятся в образ, поэтому их правка требует
# пересборки (`up -d --build`), а не рестарта. NEXT_PUBLIC_API_URL — путь на домене
# платформы: /api/* проксирует nginx.
NEXT_PUBLIC_API_URL=https://app.studenthub.kz/api/v1
NEXT_PUBLIC_APP_URL=https://app.studenthub.kz
NEXT_PUBLIC_SITE_URL=https://studenthub.kz
NEXT_PUBLIC_SALES_EMAIL=sales@studenthub.kz
