# Переменные dev-стека StudentHub (docker/dev/compose.yml).
# Скопируй в docker/dev/.env и заполни. Значения секретов НЕ коммитятся (.gitignore).

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=studenthub
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# MinIO. Пароль — минимум 8 символов, иначе сервис не стартует.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit — локальный SMTP-приёмник: письма наружу не уходят, их видно на http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
