# Dev-стек StudentHub: postgres, redis, minio, mailpit (docker/dev/compose.yml).
# Скопируй в docker/dev/.env и заполни. Файл в git не попадает (.gitignore).
#
# Читает только docker compose — подставляет значения в compose.yml. Само приложение
# (`pnpm dev`) берёт настройки из apps/api/.env: пароли там должны совпадать с этими.
#
# Формат: над каждой переменной — «обязательна или по умолчанию · кто читает · подсказка».
# Порты — на 127.0.0.1 хоста; занят порт — поменяй здесь и в apps/api/.env.

# ── PostgreSQL ───────────────────────────────────────────────────────────────────────────

# обязательна · postgres · владелец базы; в apps/api/.env — логин в DATABASE_URL
POSTGRES_USER=postgres
# обязательна · postgres · пароль в DATABASE_URL apps/api/.env
POSTGRES_PASSWORD=
# обязательна · postgres · рядом при первом старте создаётся studenthub_test (postgres/init)
POSTGRES_DB=studenthub
# по умолчанию 5432 · порт на хосте
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────────────────

# обязательна · redis · тот же пароль — REDIS_PASSWORD в apps/api/.env
REDIS_PASSWORD=
# по умолчанию 6379 · порт на хосте
REDIS_PORT=6379

# ── MinIO ────────────────────────────────────────────────────────────────────────────────

# обязательна · minio · в apps/api/.env — MINIO_ACCESS_KEY
MINIO_ROOT_USER=
# обязательна · minio · минимум 8 символов, иначе minio не стартует; в apps/api/.env — MINIO_SECRET_KEY
MINIO_ROOT_PASSWORD=
# по умолчанию 9000 · порт S3 API на хосте
MINIO_PORT=9000
# по умолчанию 9001 · веб-консоль MinIO на хосте
MINIO_CONSOLE_PORT=9001

# ── Mailpit — письма наружу не уходят, их видно в веб-интерфейсе ─────────────────────────

# по умолчанию 1025 · SMTP на хосте; в apps/api/.env — SMTP_HOST=localhost, SMTP_PORT=1025
MAILPIT_SMTP_PORT=1025
# по умолчанию 8025 · веб-интерфейс: http://localhost:8025
MAILPIT_UI_PORT=8025
