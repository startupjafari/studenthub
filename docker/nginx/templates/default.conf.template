# Домены прод-стека StudentHub.
#
# ${SH_*} подставляет envsubst при старте контейнера — значения приходят из docker/.env
# (см. docker/.env.example). Переменные самого nginx ($host, $uri, $scheme) остаются как есть:
# контейнер запущен с NGINX_ENVSUBST_FILTER='^SH_', и подставляются только наши имена.
#
# Сертификат один на все четыре имени. certbot кладёт его в каталог, названный по первому
# -d, поэтому в путях стоит ${SH_DOMAIN} — порядок доменов при выпуске важен
# (docs/RUNBOOK.md, «Прод-стек: первый запуск и сертификаты»).

# ── HTTP: проверка Let's Encrypt и редирект на HTTPS ─────────────────────────────────────
server {
  listen 80 default_server;
  server_name _;

  # Каталог общий с certbot (том certbot_www): он кладёт сюда файл проверки, nginx отдаёт.
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# ── Корневой домен: публичный сайт ───────────────────────────────────────────────────────
# default_server на 443 — лендинг: запрос с неизвестным Host попадает на публичный сайт,
# а не внутрь платформы.
server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${SH_DOMAIN} www.${SH_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  # HSTS задаётся здесь, а не в приложениях: это единственная точка терминации TLS.
  # Редирект с 80 на 443 без него защищает только тех, кто уже пришёл по http — первый
  # запрос по привычному адресу всё равно уходит открытым и его можно перехватить.
  # always — чтобы заголовок попадал и в ответы с ошибкой (301/404/5xx).
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://studenthub_landing;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# ── Платформа: web + api + WebSocket на одном origin ─────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${SH_APP_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # REST API. Префикс /api/v1 остаётся в пути — его ждёт сам api (API_PREFIX).
  location /api/ {
    proxy_pass http://studenthub_api;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # WebSocket (socket.io) — upgrade
  location /socket.io/ {
    proxy_pass http://studenthub_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Адрес клиента и схему пробрасываем и здесь: по ним api пишет логи и считает лимиты.
    # Без них каждое WS-подключение выглядит пришедшим с адреса nginx.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }

  # Next.js (web) — всё остальное
  location / {
    proxy_pass http://studenthub_web;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# ── Файловое хранилище ───────────────────────────────────────────────────────────────────
# Браузер ходит сюда напрямую: api подписывает presigned-ссылки на этот адрес
# (MINIO_PUBLIC_ENDPOINT), и файлы больше 10 МБ идут в MinIO мимо api. Без этого сервера
# ссылки указывали бы на внутреннее имя minio, которое снаружи не резолвится.
server {
  listen 443 ssl;
  http2 on;
  server_name ${SH_FILES_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://studenthub_minio;

    # Host не подменяем: подпись SigV4 считается в том числе по этому заголовку, и с чужим
    # Host MinIO ответит SignatureDoesNotMatch на каждую ссылку.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Лимит на размер тела снят: сколько можно загрузить, решает api, когда подписывает
    # ссылку. Буферизацию выключаем — иначе nginx принимает весь файл на диск прежде, чем
    # начать отдавать его в MinIO, и на больших вложениях это второй расход места и времени.
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }
}

# ── Мини-апп администраторов (Telegram) ──────────────────────────────────────────────────
# Отдельный домен: Telegram открывает мини-апп в WebView и требует https. Статику и прокси
# /api держит сам образ мини-аппа (apps/mini-app/nginx.conf.template).
server {
  listen 443 ssl;
  http2 on;
  server_name ${SH_MINI_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://studenthub_mini_app;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
