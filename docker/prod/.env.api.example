# Прод-стек StudentHub, приложение: переменные api и worker (docker/prod/compose.yml).
# Скопируй в docker/prod/.env.api и заполни. Файл в git не попадает (.gitignore).
#
# Сервисы api и worker получают этот файл как env_file. Полный список настроек приложения
# с пояснениями — apps/api/.env.example; здесь обязательные и то, что обычно нужно проду.
#
# Адреса стека здесь НЕ задаются: REDIS_HOST, REDIS_PASSWORD, MINIO_ENDPOINT, MINIO_USE_SSL,
# MINIO_PUBLIC_*, CORS_ORIGIN, APP_PUBLIC_URL, TRUST_PROXY, PORT, MEDIA_PROCESSING выводит
# compose.yml из устройства стека и доменов в .env — и перекрывает значения из этого файла.
#
# Формат: над каждой переменной — «обязательна или по умолчанию · кто читает · подсказка».

# ── База ─────────────────────────────────────────────────────────────────────────────────

# обязательна · api, worker · хост — имя сервиса `postgres`; логин, пароль и база — из .env;
# спецсимволы пароля — URL-кодировать
DATABASE_URL=postgresql://postgres:<пароль>@postgres:5432/studenthub

# ── Секреты ──────────────────────────────────────────────────────────────────────────────

# обязательна · api · минимум 32 символа: openssl rand -base64 48
JWT_ACCESS_SECRET=
# обязательна · api · минимум 32 символа, своё значение, не копия JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=
# обязательна · api · минимум 32 символа, шифрует 2FA-секреты; после смены старые не расшифруются
TOTP_ENCRYPTION_KEY=

# ── Хранилище ────────────────────────────────────────────────────────────────────────────

# обязательна · api, worker · MINIO_ROOT_USER из .env или отдельная учётка с доступом к бакетам
MINIO_ACCESS_KEY=
# обязательна · api, worker · пара к MINIO_ACCESS_KEY
MINIO_SECRET_KEY=

# ── Почта ────────────────────────────────────────────────────────────────────────────────

# необязательна · api · пусто — письма (инвайты, сброс пароля) не отправляются
SMTP_HOST=
# по умолчанию не задан · api · обычно 587 (STARTTLS) или 465
SMTP_PORT=587
# необязательна · api
SMTP_USER=
# необязательна · api
SMTP_PASS=
# необязательна · api · отправитель писем
SMTP_FROM="StudentHub <noreply@studenthub.kz>"

# ── Мониторинг ───────────────────────────────────────────────────────────────────────────

# необязательна · api, worker · пусто — Sentry не инициализируется
SENTRY_DSN=
# необязательна · api, worker · по умолчанию NODE_ENV
SENTRY_ENVIRONMENT=production

# ── Остальное ────────────────────────────────────────────────────────────────────────────
# Telegram (TELEGRAM_BOT_TOKEN, MINI_APP_URL=https://<SH_MINI_DOMAIN>), пуши (APNS_*, FCM_*,
# VAPID_*), камеры (MEDIA_JWT_PRIVATE_KEY, MEDIA_RELAY_*) — по apps/api/.env.example.
# VAPID_PUBLIC_KEY продублировать в .env как NEXT_PUBLIC_VAPID_PUBLIC_KEY: его вшивает сборка web.
# Пустая группа выключает свою функцию, а не роняет api.
