# Прод-стек StudentHub, инфраструктура (docker/prod/compose.yml).
# Скопируй в docker/prod/.env и заполни. Файл в git не попадает (.gitignore).
#
# Читает только docker compose: подставляет значения в compose.yml — контейнерам
# postgres/redis/minio/nginx, аргументам сборки web и лендинга и адресам стека у api.
# Переменные самого приложения (JWT, SMTP, Sentry …) — в .env.api (.env.api.example рядом).
# Первый запуск и выпуск сертификата — docs/RUNBOOK.md, «Прод-стек: первый запуск».
#
# Формат: над каждой переменной — «обязательна или по умолчанию · кто читает · подсказка».

# ── Домены ───────────────────────────────────────────────────────────────────────────────
# Все имена плюс www.${SH_DOMAIN} — A-записями на машину со стеком; сертификат один на все
# пять (docker/README.md, «Домены»).

# обязательна · nginx, сертификат · лендинг; первым -d при выпуске — по нему путь к сертификату
SH_DOMAIN=studenthub.kz
# обязательна · nginx, minio (CORS), mini-app, api · платформа: web + /api + /socket.io
SH_APP_DOMAIN=app.studenthub.kz
# обязательна · nginx, api · MinIO для браузера: на этот адрес api подписывает ссылки
SH_FILES_DOMAIN=files.studenthub.kz
# обязательна · nginx · мини-апп Telegram
SH_MINI_DOMAIN=mini.studenthub.kz

# необязательна · команда выпуска сертификата в docs/RUNBOOK.md; compose её не читает
CERTBOT_EMAIL=

# ── PostgreSQL ───────────────────────────────────────────────────────────────────────────

# обязательна · postgres · логин в DATABASE_URL (.env.api)
POSTGRES_USER=postgres
# обязательна · postgres · пароль в DATABASE_URL (.env.api)
POSTGRES_PASSWORD=
# обязательна · postgres · база в DATABASE_URL (.env.api)
POSTGRES_DB=studenthub
# по умолчанию 5432 · порт на 127.0.0.1 хоста: миграции и pg_dump с самой машины
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────────────────

# обязательна · redis, api, worker · compose сам передаёт его api и worker
REDIS_PASSWORD=

# ── MinIO ────────────────────────────────────────────────────────────────────────────────

# обязательна · minio · root-учётка хранилища
MINIO_ROOT_USER=
# обязательна · minio · минимум 8 символов, иначе minio не стартует
MINIO_ROOT_PASSWORD=

# ── Сборка web и лендинга ────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* вшиваются в образ при сборке: правка — `up -d --build`, а не рестарт.

# по умолчанию https://${SH_APP_DOMAIN}/api/v1 · сборка web · путь на домене платформы,
# /api/* проксирует nginx
NEXT_PUBLIC_API_URL=
# по умолчанию https://${SH_FILES_DOMAIN} · сборка web · хранилище в CSP (картинки, видео)
NEXT_PUBLIC_MINIO_URL=
# необязательна · сборка web · тот же ключ, что VAPID_PUBLIC_KEY в .env.api; пусто — без push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# необязательна · сборка web · DSN Sentry для браузера; пусто — трекер выключен
NEXT_PUBLIC_SENTRY_DSN=
# по умолчанию production · сборка web
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# необязательна · сборка web · метка релиза, например SHA коммита
NEXT_PUBLIC_SENTRY_RELEASE=
# необязательна · сборка web · доля трассируемых запросов 0–1; пусто — трассировка вырезана
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# по умолчанию https://${SH_APP_DOMAIN} · сборка лендинга · кнопки «Войти» и 308-редиректы
NEXT_PUBLIC_APP_URL=
# по умолчанию https://${SH_DOMAIN} · сборка лендинга · канонический адрес сайта
NEXT_PUBLIC_SITE_URL=
# обязательна · сборка лендинга · адрес отдела продаж на сайте; пустое значение так и вшивается
NEXT_PUBLIC_SALES_EMAIL=sales@studenthub.kz
