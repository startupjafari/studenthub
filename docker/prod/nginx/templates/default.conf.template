# Домены прод-стека StudentHub (docker/README.md, «Домены прода»).
# ${SH_*} подставляет envsubst при старте из docker/prod/.env; $host, $uri nginx не трогаются.
# Сертификат один на все пять имён, каталог — по первому -d, поэтому в путях ${SH_DOMAIN}.

# ── HTTP: проверка Let's Encrypt и редирект на HTTPS ─────────────────────────────────────
server {
  listen 80 default_server;
  server_name _;

  # Каталог общий с certbot (том certbot_www): он кладёт сюда файл проверки, nginx отдаёт.
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# ── Корневой домен: публичный сайт ───────────────────────────────────────────────────────
# default_server на 443 — лендинг: запрос с неизвестным Host попадает на публичный сайт,
# а не внутрь платформы.
server {
  listen 443 ssl default_server;
  http2 on;
  server_name ${SH_DOMAIN} www.${SH_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  # HSTS — здесь, в единственной точке терминации TLS; always — и в ответах с ошибкой
  # (docker/README.md, «Решения»).
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://studenthub_landing;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# ── Платформа: web + api + WebSocket на одном origin ─────────────────────────────────────
server {
  listen 443 ssl;
  http2 on;
  server_name ${SH_APP_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  # REST API. Префикс /api/v1 остаётся в пути — его ждёт сам api (API_PREFIX).
  location /api/ {
    proxy_pass http://studenthub_api;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # WebSocket (socket.io) — upgrade
  location /socket.io/ {
    proxy_pass http://studenthub_api;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Адрес клиента и схему пробрасываем и здесь: по ним api пишет логи и считает лимиты.
    # Без них каждое WS-подключение выглядит пришедшим с адреса nginx.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
  }

  # Next.js (web) — всё остальное
  location / {
    proxy_pass http://studenthub_web;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}

# ── Файловое хранилище ───────────────────────────────────────────────────────────────────
# Браузер ходит сюда напрямую по presigned-ссылкам api (MINIO_PUBLIC_ENDPOINT): внутреннее
# имя minio снаружи не резолвится.
server {
  listen 443 ssl;
  http2 on;
  server_name ${SH_FILES_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://studenthub_minio;

    # Host не подменять: по нему считается подпись SigV4, иначе SignatureDoesNotMatch.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Размер решает api при подписи ссылки; без буферизации файл не ложится на диск nginx.
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
  }
}

# ── Мини-апп администраторов (Telegram) ──────────────────────────────────────────────────
# Отдельный домен: Telegram открывает мини-апп в WebView и требует https. Статику и прокси
# /api держит сам образ мини-аппа (apps/mini-app/nginx.conf.template).
server {
  listen 443 ssl;
  http2 on;
  server_name ${SH_MINI_DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${SH_DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${SH_DOMAIN}/privkey.pem;

  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location / {
    proxy_pass http://studenthub_mini_app;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
