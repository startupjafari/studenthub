{
  "name": "studenthub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start --filter='!camera-agent'",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:small": "SEED_SCALE=small node prisma/seed.mjs",
    "db:seed:full": "SEED_SCALE=full node --max-old-space-size=4096 prisma/seed.mjs",
    "db:seed:test": "node --max-old-space-size=4096 prisma/seed-test.mjs",
    "db:seed:media": "SEED_ONLY=media node prisma/seed.mjs",
    "db:seed:kato": "SEED_ONLY=kato node prisma/seed.mjs",
    "db:seed:library": "node prisma/seed-library.mjs",
    "db:seed:stickers": "node prisma/seed-stickers.mjs",
    "db:reset:admin": "node prisma/reset-to-admin.mjs",
    "test:seed": "node --test 'prisma/seed/**/*.test.mjs'",
    "infra:up": "docker compose -f docker/dev/compose.yml up -d --wait",
    "infra:down": "docker compose -f docker/dev/compose.yml down",
    "infra:ps": "docker compose -f docker/dev/compose.yml ps",
    "infra:logs": "docker compose -f docker/dev/compose.yml logs -f --tail=100",
    "cameras:up": "docker compose -f docker/camera-sim/compose.yml up -d",
    "cameras:down": "docker compose -f docker/camera-sim/compose.yml --profile '*' down",
    "relay:up": "docker compose -f docker/media-relay/compose.yml up -d --build",
    "relay:down": "docker compose -f docker/media-relay/compose.yml down"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.10",
    "prisma": "^6.19.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0"
  },
  "pnpm": {
    "auditConfig": {
      "_comment": "Находки, для которых совместимого обновления нет. (1) stream-json (GHSA-hqr4-qq8f-hg3x, GHSA-mjw6-4jj6-33hc) и decode-uri-component — транзитивные зависимости клиента minio. Патч stream-json есть (3.6.0), но взять его нельзя: minio 8.0.7 (последняя на 10.10.2026) делает require(\"stream-json/jsonl/Parser.js\"), а в 3.x файл называется parser.js и лежит под src/ — карта exports \"./*\": \"./src/*\" ведёт на ./src/jsonl/Parser.js, которого не существует. На регистрозависимой ФС это падение на старте. Сюда же decode-uri-component GHSA-qr28-fpjm-wq7f: патч только в 0.5.1, а с 0.4 пакет стал ESM-only, тогда как query-string из minio подключает его через require(). Снять, когда minio уедет с этих пакетов. (2) braces GHSA-vfj7-8cjw-p6xm: исправленной версии не существует вовсе — уязвимы все <=3.0.3, а 3.0.3 последняя; пакет приходит транзитивно через micromatch из сборочного инструментария. Снять, когда выйдет патч. (3) zod GHSA-mrhx-c7xc-m3w5: исправлен только в 4.6.6, в линейке 3.x патча нет — нужен переход на zod 4. Память исчерпывается лишь на огромных коллекциях, а тело запроса и так ограничено bodyLimit Fastify. Снять с переходом на zod 4. (4) Временно, с 06.11.2026: glob GHSA-3g3m-2fjr-6pw4 и minimatch GHSA-g3hv-75wg-m249 — транзитивно через @fastify/static (из @nestjs/platform-fastify). Исправлены только в glob 14 / minimatch 11, а @fastify/static перешёл на glob 14 в 10.1.9 (04.11) — моложе выдержки minimumReleaseAge (7 суток). Снять после 13.11.2026, обновив @fastify/static.",
      "ignoreGhsas": [
        "GHSA-vcc3-ghjq-m6fr",
        "GHSA-528h-pc64-c93x",
        "GHSA-hqr4-qq8f-hg3x",
        "GHSA-mjw6-4jj6-33hc",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-qr28-fpjm-wq7f",
        "GHSA-3g3m-2fjr-6pw4",
        "GHSA-g3hv-75wg-m249"
      ]
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ],
    "overrides": {
      "fast-uri@^3": "^3.1.9",
      "fast-uri@^4": "^4.2.3",
      "find-my-way": "^9.7.0",
      "fastify": "^5.12.6",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^2": "^2.1.4",
      "serialize-javascript": "^7.1.3",
      "deepmerge-ts": "^8.0.0",
      "js-yaml@^5": "^5.2.2",
      "postcss": "^8.5.18",
      "nanoid@^3": "^3.3.18",
      "@fastify/static": "^10.1.1",
      "brace-expansion@^5": "^5.0.9",
      "axios": "^1.20.0",
      "undici@^7": "^7.30.1",
      "@nestjs/platform-fastify": "^11.2.4",
      "engine.io": "^6.6.10",
      "hono": "^4.12.34",
      "ip-address": "^10.7.4",
      "qs": "^6.16.1",
      "@fastify/busboy": "^3.2.2",
      "proxy-addr": "^2.0.8",
      "@modelcontextprotocol/sdk": "^1.32.1",
      "postcss-selector-parser": "^7.1.6",
      "fast-copy": "^4.1.1",
      "source-map-js": "^1.2.2",
      "handlebars": "^4.7.10",
      "katex": "0.18.10",
      "markdown-it@^14": "^14.3.3",
      "follow-redirects": "^1.16.2",
      "vite@^8": "^8.3.5",
      "body-parser@^2": "^2.4.0",
      "systeminformation": "^5.33.16",
      "@hono/node-server": "^2.1.3"
    }
  }
}
