{
  "name": "studenthub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:small": "SEED_SCALE=small node prisma/seed.mjs",
    "db:seed:full": "SEED_SCALE=full node --max-old-space-size=4096 prisma/seed.mjs",
    "db:seed:test": "node --max-old-space-size=4096 prisma/seed-test.mjs",
    "db:seed:media": "SEED_ONLY=media node prisma/seed.mjs",
    "db:seed:kato": "SEED_ONLY=kato node prisma/seed.mjs",
    "db:reset:admin": "node prisma/reset-to-admin.mjs",
    "test:seed": "node --test 'prisma/seed/**/*.test.mjs'"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0"
  },
  "pnpm": {
    "auditConfig": {
      "_comment": "Находки, для которых совместимого обновления нет. (1) Транзитивные зависимости клиента minio — decode-uri-component через query-string и stream-json: minio 8.0.7 (последняя) по-прежнему делает require(\"stream-json/jsonl/Parser.js\"), а в stream-json 3.5+ этого файла нет — с обновлением API не стартует (проверено распаковкой пакета). Снять, когда minio уедет с этих пакетов. (2) braces GHSA-vfj7-8cjw-p6xm: исправленной версии не существует вовсе — уязвимы все <=3.0.3, а 3.0.3 последняя; пакет приходит из сборочного инструментария @ducanh2912/next-pwa. Снять, когда выйдет патч.",
      "ignoreGhsas": [
        "GHSA-vcc3-ghjq-m6fr",
        "GHSA-528h-pc64-c93x",
        "GHSA-hqr4-qq8f-hg3x",
        "GHSA-mjw6-4jj6-33hc",
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-68fv-2mgg-jv7q"
      ],
      "_comment_temporary": "ВРЕМЕННО, снять сегодня же. GHSA-68fv-2mgg-jv7q (source-map-js <1.2.2) — исправление есть, но версия 1.2.2 опубликована 2026-09-30 14:08 UTC и до 2026-10-07 14:08 UTC не проходит выдержку minimumReleaseAge (7 суток, pnpm-workspace.yaml). Ослаблять выдержку через minimumReleaseAgeExclude ради этого не стали: она защищает от подменённого пакета, а здесь DoS в разборе source map у сборочного инструментария (postcss, prisma CLI), не в обработке запросов. После 14:08 UTC: убрать этот ключ и GHSA из ignoreGhsas, добавить \"source-map-js\": \"^1.2.2\" в overrides и обновить лок."
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ],
    "overrides": {
      "fast-uri@^3": "^3.1.6",
      "fast-uri@^4": "^4.1.3",
      "find-my-way": "^9.7.0",
      "fastify": "^5.12.1",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^2": "^2.1.4",
      "serialize-javascript": "^7.1.2",
      "deepmerge-ts": "^8.0.0",
      "js-yaml@^5": "^5.2.2",
      "postcss": "^8.5.18",
      "nanoid@^3": "^3.3.18",
      "@fastify/static": "^10.1.1",
      "brace-expansion@^5": "^5.0.9",
      "axios": "^1.20.0",
      "undici@^7": "^7.29.1",
      "@nestjs/platform-fastify": "^11.2.4",
      "engine.io": "^6.6.10",
      "hono": "^4.12.34",
      "ip-address": "^10.5.1",
      "qs": "^6.16.0",
      "@fastify/busboy": "^3.2.2"
    }
  }
}
