// Домен «Академическая структура» (docs/PROJECT.md §6): University, Faculty, Group, Room.
// Иерархия University → Faculty → Group; Room привязан к университету.
// onDelete: Restrict — удаление родителя при наличии детей запрещено на уровне БД
// (дублируется сервис-гвардами задач 5.2–5.4). Scope-поля User связаны отсюда.

model University {
  id        String           @id @default(uuid())
  name      String
  shortName String?          @map("short_name")
  status    UniversityStatus @default(PENDING)
  country   String?
  city      String?
  // Таймзона вуза для расписания/событий (docs/PROJECT.md §6.2; используется с Ф6).
  timezone  String           @default("Asia/Almaty")

  // Страница университета (как профиль): витрина для своих и для компаний с допуском.
  // Логотип и обложка — raw-объекты публичного бакета profile-covers, ссылку строит сервер.
  logoUrl      String? @map("logo_url")
  coverUrl     String? @map("cover_url")
  description  String?
  website      String?
  foundedYear  Int?    @map("founded_year")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")
  address      String?
  telegram     String?
  instagram    String?
  linkedin     String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculties         Faculty[]
  specialties       Specialty[]
  rooms             Room[]
  campuses          Campus[]
  users             User[]
  posts             Post[]
  stories           Story[]
  chats             Chat[]
  events            Event[]
  complaints        Complaint[]
  documents         Document[]
  documentRequests  DocumentRequest[]
  documentTypes     DocumentType[]
  // DOCX-шаблоны документов вуза (37-document-templates.prisma).
  documentTemplates DocumentTemplate[]
  appServices       ApplicationService[]      @relation("UniversityApplicationServices")
  applicationsV2    Application[]             @relation("UniversityApplicationsV2")
  subjects          Subject[]
  terms             Term[]
  companyAccess     CompanyUniversityAccess[] @relation("UniversityCompanyAccess")
  vacancyReviews    VacancyUniversityReview[] @relation("UniversityVacancyReviews")
  demoRequests      UniversityDemoRequest[]   @relation("UniversityDemoRequest")

  // Контент страницы университета: публикует админ или модератор вуза от его имени.
  // Отдельные связи, а не universityId: тот у постов — scope аудитории, а не владелец.
  pagePosts        Post[]                @relation("UniversityPagePosts")
  pageArticles     ProfileArticle[]      @relation("UniversityPageArticles")
  pagePolls        Poll[]                @relation("UniversityPagePolls")
  pageAlbums       Album[]               @relation("UniversityPageAlbums")
  pageMedia        File[]                @relation("UniversityPageMedia")
  onboarding       UniversityOnboarding? @relation("UniversityOnboarding")
  cameraAgents     CameraAgent[]
  cameras          Camera[]
  campusSpaces     CampusSpaceIndex[]
  cameraSettings   CameraSettings?
  cameraViews      CameraViewSession[]
  librarySettings  LibrarySettings?
  books            Book[]
  bookCopies       BookCopy[]
  loans            Loan[]
  reservations     Reservation[]
  libraryIdAccess  LibraryIdAccessLog[]
  securityVisitors SecurityVisitor[]
  securityPasses   SecurityPass[]

  @@index([status])
  @@map("universities")
}

// Справочник специальностей вуза (ведёт админ вуза). В профиле хранится строкой-названием.
model Specialty {
  id           String   @id @default(uuid())
  name         String
  universityId String   @map("university_id")
  createdAt    DateTime @default(now()) @map("created_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([universityId, name])
  @@index([universityId])
  @@map("specialties")
}

model Faculty {
  id           String   @id @default(uuid())
  name         String
  universityId String   @map("university_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university     University           @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  groups         Group[]
  users          User[]
  applicationsV2 Application[]        @relation("FacultyApplicationsV2")
  posts          Post[]
  stories        Story[]
  chats          Chat[]
  events         Event[]
  appointments   DeaneryAppointment[]

  @@index([universityId])
  @@map("faculties")
}

model Group {
  id         String   @id @default(uuid())
  name       String
  // Год набора / курс (опционально).
  year       Int?
  facultyId  String   @map("faculty_id")
  // Староста группы: не более одной группы на пользователя (@unique).
  starostaId String?  @unique @map("starosta_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  faculty   Faculty    @relation(fields: [facultyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  starosta  User?      @relation("GroupStarosta", fields: [starostaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  students  User[]     @relation("GroupMembers")
  schedules Schedule[]
  pairs     Pair[]
  posts     Post[]
  stories   Story[]
  chats     Chat[]
  events    Event[]
  materials Material[]
  courses   Course[]
  exams     Exam[]

  @@index([facultyId])
  @@map("groups")
}

model Room {
  id           String    @id @default(uuid())
  name         String
  capacity     Int?
  universityId String    @map("university_id")
  // Назначение помещения (Ф16): определяет, что показывать студенту по QR — пару из
  // расписания (учебные) или часы работы и контакт (библиотека, бухгалтерия, актовый зал).
  kind         RoomKind  @default(AUDITORIUM)
  // Ориентиры для навигации и для печатной наклейки: «Корпус Б, 3 этаж».
  building     String?
  floor        Int?
  // Только для неучебных помещений: свободный текст, т.к. режимы работы у вузов разные
  // («Пн–Пт 09:00–18:00, обед 13:00–14:00»). Разбирать в структуру смысла нет — показываем как есть.
  openHours    String?   @map("open_hours")
  phone        String?
  info         String?
  // Код в печатном QR (Ф16). Отдельный короткий код, а НЕ id аудитории:
  //   1) короче → QR менее плотный, читается с большего расстояния и лучше печатается;
  //   2) перевыпуск кода обесценивает старые распечатки (помещение перепрофилировали,
  //      наклейка утекла) — id так не отозвать.
  qrCode       String?   @unique @map("qr_code")
  qrIssuedAt   DateTime? @map("qr_issued_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  university         University         @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pairs              Pair[]
  scheduleChanges    ScheduleChange[]   @relation("ScheduleChangeNewRoom")
  exams              Exam[]             @relation("ExamRoom")
  cameras            Camera[]
  campusSpaceIndexes CampusSpaceIndex[]

  @@index([universityId])
  @@map("rooms")
}
