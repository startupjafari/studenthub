// Домен «Чаты» (docs/PROJECT.md §3.6, §9; задачи Ф9).
// Chat — беседа (личная, групповая, официальная). ChatMember — членство (+ lastReadAt для статусов
// прочтения). Message — сообщение (soft delete §5.1, thread-ответы replyToId, вложения File.messageId).
// Официальные чаты (GROUP_OFFICIAL/SUBJECT/FACULTY/DEAN/SUPPORT) привязаны к academic-скоупу.
// Транспорт — socket.io (ChatGateway); REST — история и управление участниками. Enum ChatType — в _enums.prisma.

model Chat {
  id          String   @id @default(uuid())
  type        ChatType
  title       String?
  // Аватар группы (Ф9+): публичный URL в бакете avatars. Только для пользовательских GROUP-чатов.
  avatarUrl   String?  @map("avatar_url")
  // Создатель пользовательского GROUP-чата (Ф9+): «админ» группы — может банить участников и менять аватар.
  createdById String?  @map("created_by_id")

  // Academic-скоуп официальных чатов (для авто-создания и адресации).
  universityId String? @map("university_id")
  facultyId    String? @map("faculty_id")
  groupId      String? @map("group_id")
  subject      String?

  // Аллокатор Message.seq: инкрементируется атомарно при создании каждого сообщения чата.
  // Нужен для дельта-догона после обрыва связи (GET /chats/:id/updates, docs/PROJECT.md §9).
  lastSeq Int @default(0) @map("last_seq")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  university University?  @relation(fields: [universityId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  faculty    Faculty?     @relation(fields: [facultyId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  group      Group?       @relation(fields: [groupId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  members    ChatMember[]
  messages   Message[]

  @@index([type])
  @@index([universityId])
  @@index([facultyId])
  @@index([groupId])
  @@map("chats")
}

model ChatMember {
  id         String    @id @default(uuid())
  chatId     String    @map("chat_id")
  userId     String    @map("user_id")
  // Время последнего прочтения — база для непрочитанных и статусов message:read.
  lastReadAt DateTime? @map("last_read_at")
  // Отключение уведомлений о новых сообщениях для этого участника (Ф9+): не null — заглушено «навсегда».
  mutedAt    DateTime? @map("muted_at")
  // Заглушено до момента (§17, mute на время): участник считается muted, пока mutedUntil > now.
  mutedUntil DateTime? @map("muted_until")
  // Бан участника в группе (Ф9+): не null — забанен создателем, не может писать и не видит чат.
  bannedAt   DateTime? @map("banned_at")
  // Админ группы (Ф9+): может банить, менять аватар/название, добавлять/убирать участников.
  isAdmin    Boolean   @default(false) @map("is_admin")
  // Очистка истории «для меня» (Ф9+): сообщения с createdAt <= clearedAt скрыты у этого участника.
  clearedAt  DateTime? @map("cleared_at")
  // «Удалить чат у себя» для PRIVATE (Telegram-стиль): не null — чат скрыт из списка этого участника.
  // Членство сохраняется (сообщения продолжают приходить); новое сообщение сбрасывает hiddenAt → чат возвращается.
  hiddenAt   DateTime? @map("hidden_at")
  // Черновик сообщения (Ф9+, синхронизация между устройствами как в Telegram): последний
  // несохранённый текст ввода этого участника в чате. null/пусто — черновика нет.
  draft      String?
  // Закрепление чата «у себя» (Telegram-стиль): не null — чат закреплён этим участником и показывается
  // сверху списка (сортировка по времени закрепления). Персонально, другим участникам не видно.
  pinnedAt   DateTime? @map("pinned_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
  @@map("chat_members")
}

model Message {
  id              String    @id @default(uuid())
  chatId          String    @map("chat_id")
  // Монотонный номер сообщения внутри чата (аллокатор — Chat.lastSeq). Клиент хранит последний
  // применённый seq и после реконнекта забирает только разницу, а не страницу истории заново.
  seq             Int
  senderId        String    @map("sender_id")
  content         String
  // Thread-ответ на другое сообщение того же чата.
  replyToId       String?   @map("reply_to_id")
  // Пересылка (Ф9+): ссылка на исходное сообщение-источник (может быть из другого чата).
  forwardedFromId String?   @map("forwarded_from_id")
  editedAt        DateTime? @map("edited_at")
  deletedAt       DateTime? @map("deleted_at")
  // Закрепление сообщения в чате (Ф9+): кто и когда закрепил.
  pinnedAt        DateTime? @map("pinned_at")
  pinnedById      String?   @map("pinned_by_id")
  // Расшаренный пост (Ф9+ share-to-chat): превью-карточка поста в сообщении.
  sharedPostId    String?   @map("shared_post_id")
  // Инлайн-превью первой ссылки (Ф9+): OG-мета {url,title,description,image,siteName}.
  // Заполняется асинхронно джобой link-preview; наружу отдаётся как есть.
  linkPreview     Json?     @map("link_preview")
  // Системное сообщение группы (§20): тип события (member_added, title_changed, …) + денормализованные
  // детали для рендера {targetName?, title?}. NULL — обычное сообщение. senderId = инициатор события.
  systemType      String?   @map("system_type")
  systemMeta      Json?     @map("system_meta")
  createdAt       DateTime  @default(now()) @map("created_at")

  chat          Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sender        User              @relation(fields: [senderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  replyTo       Message?          @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  replies       Message[]         @relation("MessageReply")
  forwardedFrom Message?          @relation("MessageForward", fields: [forwardedFromId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  forwards      Message[]         @relation("MessageForward")
  pinnedBy      User?             @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  sharedPost    Post?             @relation("MessageSharedPost", fields: [sharedPostId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  media         File[]
  reactions     MessageReaction[]
  // Опрос в чате (§38): 1:1 с сообщением-опросом (ChatPoll.messageId уникален).
  poll          ChatPoll?

  // Дельта-догон: range-скан `chatId + seq > since`. Уникальность заодно защищает от дублей
  // при гонке аллокатора.
  @@unique([chatId, seq])
  // История сообщений — cursor-пагинация по [chatId, createdAt] (docs/PROJECT.md §6.2).
  @@index([chatId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@index([forwardedFromId])
  @@index([pinnedById])
  @@index([sharedPostId])
  // Закреплённые сообщения чата.
  @@index([chatId, pinnedAt])
  @@index([deletedAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  // Эмодзи-реакция; один пользователь может поставить несколько разных эмодзи на сообщение.
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Идемпотентность: один и тот же эмодзи от пользователя к сообщению — один раз.
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
  @@map("message_reactions")
}

// Опрос в чате (§38–39). Привязан 1:1 к сообщению-опросу (ChatPoll.messageId уникален) —
// удаление сообщения каскадно удаляет опрос. Настройки (§39): multiple — множественный выбор;
// anonymous — скрыть, кто как проголосовал; allowRevote — можно менять голос; randomOrder —
// показывать варианты в случайном порядке (перемешивает клиент); closed — опрос завершён.
model ChatPoll {
  id          String   @id @default(uuid())
  messageId   String   @unique @map("message_id")
  question    String
  multiple    Boolean  @default(false)
  anonymous   Boolean  @default(false)
  allowRevote Boolean  @default(true) @map("allow_revote")
  randomOrder Boolean  @default(false) @map("random_order")
  closed      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  message Message          @relation(fields: [messageId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  options ChatPollOption[]
  votes   ChatPollVote[]

  @@map("chat_polls")
}

model ChatPollOption {
  id     String @id @default(uuid())
  pollId String @map("poll_id")
  text   String
  order  Int

  poll  ChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  votes ChatPollVote[]

  @@index([pollId])
  @@map("chat_poll_options")
}

model ChatPollVote {
  id        String   @id @default(uuid())
  pollId    String   @map("poll_id")
  optionId  String   @map("option_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  poll   ChatPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  option ChatPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Один голос за конкретный вариант от пользователя (защита от дублей). Множественный выбор —
  // это несколько строк с разными optionId. Перевыбор/снятие — удаление/вставка строк в транзакции.
  @@unique([optionId, userId])
  @@index([pollId, userId])
  @@index([userId])
  @@map("chat_poll_votes")
}
