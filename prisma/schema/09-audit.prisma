// AuditLog — журнал действий (docs/PROJECT.md §11.4, docs/BACKEND_RULES.md §13).
// Введён в Ф1 (нужен для аудита login/logout/инвайтов); Ф11 добавит AuditInterceptor и GET /audit.
// userId намеренно без FK: запись аудита переживает удаление пользователя.

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
