// Домен «Уведомления» (docs/PROJECT.md §5, §8, §9; docs/BACKEND_RULES.md §9).
// Notification — запись в БД, создаётся процессором очереди `notifications` и
// доставляется онлайн-клиенту WS-событием `notification:new`. NotificationSettings —
// пользовательские настройки каналов: одна строка на пользователя.
// Enum'ы NotificationType/NotificationChannel — в _enums.prisma.

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  // Текст, уже отрисованный на языке получателя в момент создания. Нужен сам по себе:
  // push и письмо-зеркало уходят с сервера и готовую строку требуют, а не ключ.
  title     String
  body      String
  // Ключ сообщения и его параметры — чтобы тот же текст можно было отрисовать заново.
  // Человек меняет язык в настройках и ожидает увидеть на новом языке и старые
  // уведомления тоже; без ключа пришлось бы либо переводить задним числом хранимую
  // строку, либо оставить ленту двуязычной.
  //
  // NULL у записей, созданных до появления полей, и у уведомлений без словарной статьи
  // (например заголовок — имя отправителя сообщения). Клиент в этом случае показывает
  // `title`/`body` как есть.
  titleKey  String?          @map("title_key")
  bodyKey   String?          @map("body_key")
  params    Json?
  // Полезная нагрузка: только идентификаторы для перехода (chatId, postId,
  // applicationId, eventId, url и т.п.). Целые сущности не храним.
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  // Ключ идемпотентности: стабильный идентификатор источника (например `new-message:{messageId}`).
  // Уникален в пределах пользователя — повторный запуск job'а не создаёт дубликат (docs/PROJECT.md §10.1).
  // NULL разрешён для уведомлений без источника; Postgres считает NULL-значения различными.
  dedupeKey String?          @map("dedupe_key")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Список уведомлений пользователя по времени; частичный запрос непрочитанных;
  // [isRead, createdAt] — для cron cleanOldNotifications (прочитанные старше 30 дней).
  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@index([isRead, createdAt])
  @@map("notifications")
}

model NotificationSettings {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Мастер-переключатели каналов доставки. IN_APP (колокол) доставляется всегда,
  // отдельного флага не имеет. PUSH выключен по умолчанию до Ф13.3.
  emailEnabled Boolean @default(true) @map("email_enabled")
  pushEnabled  Boolean @default(false) @map("push_enabled")

  // Пер-тип отключение: если тип выключен — уведомление не создаётся и не рассылается
  // ни по одному каналу (кроме SYSTEM, который сервис доставляет принудительно).
  scheduleChangeEnabled Boolean @default(true) @map("schedule_change_enabled")
  appUpdateEnabled      Boolean @default(true) @map("app_update_enabled")
  messageEnabled        Boolean @default(true) @map("message_enabled")
  postEnabled           Boolean @default(true) @map("post_enabled")
  eventEnabled          Boolean @default(true) @map("event_enabled")
  systemEnabled         Boolean @default(true) @map("system_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("notification_settings")
}

// Подписка браузера на Web Push (Ф13.3). Одна строка на устройство/браузер (endpoint уникален).
// p256dh/auth — ключи из PushSubscription.getKey(); используются web-push для шифрования payload.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Токен устройства для пушей (план iOS, Задача Б1).
//
// Нативное приложение не умеет Web Push: на iOS доставка идёт через APNs, и адресом
// служит токен, который система выдаёт приложению на конкретном устройстве. Таблица
// отдельная от PushSubscription, потому что это другой транспорт с другим адресом,
// другим сроком жизни и другой причиной смерти; складывать их в одну значило бы
// хранить половину полей пустыми у каждой строки.
model DeviceToken {
  id       String         @id @default(uuid())
  userId   String         @map("user_id")
  platform DevicePlatform
  // Токен APNs. Уникален: система выдаёт его устройству, и одно устройство не может
  // числиться дважды. Переустановка приложения даёт новый токен, старый умирает сам.
  token    String         @unique
  // Версия сборки, которая зарегистрировала токен. Нужна при разборе жалоб: «не
  // приходят уведомления» почти всегда про конкретную версию.
  appVersion String?      @map("app_version")
  // Последняя регистрация. Приложение подтверждает токен при каждом запуске, и по
  // этой отметке чистятся устройства, которые не заходили месяцами.
  lastSeenAt DateTime     @default(now()) @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Отправка идёт по пользователю: всем его устройствам сразу.
  @@index([userId])
  @@map("device_tokens")
}
