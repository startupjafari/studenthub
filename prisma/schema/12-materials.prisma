// Домен «Учебные материалы» (docs/PROJECT.md §12 teacher/materials).
// Material — материал, который преподаватель публикует для группы: заголовок/описание +
// прикреплённые файлы (File.materialId, бакет materials) и/или внешняя ссылка (url).
// Видят: участники группы и преподаватель-автор; управляет автор/админ.

model Material {
  id          String  @id @default(uuid())
  teacherId   String  @map("teacher_id")
  groupId     String  @map("group_id")
  subject     String?
  title       String
  description String?
  // Внешняя ссылка (напр. на облако) — альтернатива/дополнение к файлам.
  url         String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  teacher User   @relation("MaterialAuthor", fields: [teacherId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  media   File[]

  @@index([groupId, createdAt])
  @@index([teacherId])
  @@map("materials")
}
