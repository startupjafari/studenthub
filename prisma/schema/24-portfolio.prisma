// Домен «Портфолио» (docs/ACADEMIC_CORE.md, задача 21). PortfolioItem — запись студенческого
// портфолио: образование / опыт / проект / сертификат / достижение, с периодом и ссылкой.
// visibility — приватность записи: PRIVATE (только владелец) / UNIVERSITY (вуз) / PUBLIC (все).
// Вид (kind) и видимость — строкой (SSOT — shared-schemas).

model PortfolioItem {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  kind         String    @default("PROJECT")
  title        String
  organization String?
  description  String?
  url          String?
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  visibility   String    @default("UNIVERSITY")
  order        Int       @default(0)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation("UserPortfolio", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, kind])
  @@map("portfolio_items")
}
