// Журнал выгруженных документов (план брендирования, этап A6).
//
// Отдельная таблица, а не `AuditLog`, по двум причинам. Первая: журналу нужен стабильный
// публичный идентификатор — он печатается в колонтитуле документа и по нему документ
// проверяют; в аудите такого поля нет. Вторая: cron `cleanAuditLogs` чистит записи старше
// 90 дней, а журнал выданных документов так терять нельзя — по нему подтверждают
// подлинность справки, которая на руках у человека годами.
//
// Событие «выгрузили файл» при этом пишется и в AuditLog тоже: там оно стоит в общей
// ленте действий пользователя, здесь — в реестре документов.
model DocumentExport {
  id String @id @default(uuid())

  /// Короткий код для колонтитула и ссылки проверки: алфавит без похожих символов,
  /// человек читает его с бумаги (common/crypto/readable-code).
  shortId String @unique @map("short_id")

  /// Кто выгрузил. Скаляр без FK — как userId в AuditLog: запись переживает удаление
  /// аккаунта, иначе журнал перестал бы быть журналом.
  userId String? @map("user_id")

  /// Вид выгрузки (resume | users | chat | ...) и формат файла.
  kind   String
  format String

  /// Параметры выборки: по какому фильтру собран файл. Без персональных данных — только
  /// условия (роль, факультет, поисковая строка).
  params Json?

  /// Сколько строк или сообщений попало в файл. Для документа — null.
  rows Int?

  // ── Поля официального документа ───────────────────────────────────────────
  // Заполняются только у выданных документов (справка, транскрипт) и нужны странице
  // проверки: человек с бумагой в руках сверяет её с тем, что показывает платформа.
  // Хранятся снимком на момент выдачи — журнал не должен меняться задним числом, если
  // студент сменил фамилию или вуз переименовали.

  /// Кому выдан. На странице проверки показывается в маскированном виде («О***а А.Б.»):
  /// код короткий и подбираем, и раздавать по нему ФИО целиком нельзя.
  subjectName String? @map("subject_name")

  /// Номер документа (он же номер заявки, SH-2026-001842).
  documentNumber String? @map("document_number")

  /// Кто выдал — название вуза строкой на момент выдачи.
  issuerName String? @map("issuer_name")

  ip        String?
  userAgent String? @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  /// Документ отозван: проверка обязана показать это, а не «подлинный». Для рабочих
  /// выгрузок всегда null — отзывать нечего.
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@index([createdAt])
  @@map("document_exports")
}
