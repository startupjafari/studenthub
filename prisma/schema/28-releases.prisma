// Релизы: отметка о том, что пользователь прочитал «Что нового» (docs/RELEASE.md).
//
// Текста релиза здесь нет и не будет: он едет в бандле web вместе с кодом, который
// описывает. Это не экономия таблицы, а единственный способ не соврать — у PWA с
// домашнего экрана открытая страница неделями работает на старой сборке, и нота,
// прилетевшая из API раньше нового бандла, рассказывала бы про кнопки, которых у
// человека ещё нет. Бандл и его нота обновляются одним действием.
//
// Сервер хранит ровно состояние «до какой версии человек дочитал», одна строка на
// пользователя: userId — первичный ключ, поэтому отдельный индекс по FK не нужен.

model ReleaseView {
  userId  String   @id @map("user_id")
  // Версия релиза в SemVer («1.7.0»), та же, что в package.json и в теге.
  version String
  seenAt  DateTime @default(now()) @map("seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("release_views")
}
