// Привязка аккаунта Telegram к пользователю платформы — для админского мини-аппа.
//
// Зачем таблица вообще. Telegram при открытии мини-аппа присылает подписанную строку
// initData со своим `user.id`. Подпись доказывает, что строка пришла от Telegram и не
// подделана, но НЕ говорит, кто этот человек на платформе: `telegram_id` идентифицирует,
// но не авторизует. Соответствие «этот Telegram — этот админ» устанавливается один раз,
// в вебе, где человек уже доказал, кто он, и хранится здесь.
//
// Почему не по `username`. В Telegram он меняется и переиспользуется: отданный кем-то
// @ivanov через месяц может принадлежать другому человеку. Здесь он лежит только для
// показа в интерфейсе («привязан @ivanov») и в поиске не участвует.
//
// Одна привязка на пользователя и одна на Telegram — оба поля уникальны. Перепривязка
// возможна только после явного отзыва: молчаливая замена означала бы, что доступ
// администратора переезжает на другой телефон незаметно для него самого.
//
// Кодов привязки здесь нет: они живут в Redis минуты и переживать рестарт им незачем.

model TelegramAccount {
  id String @id @default(uuid())

  userId     String @unique @map("user_id")
  telegramId BigInt @unique @map("telegram_id")

  /// Только для показа. Не участвует в поиске и авторизации.
  username String?

  linkedAt   DateTime  @default(now()) @map("linked_at")
  /// Последнее открытие мини-аппа — чтобы видеть заброшенные привязки и отзывать их.
  lastSeenAt DateTime? @map("last_seen_at")
  /// Отзыв: строка остаётся для истории, но сессии по ней больше не выдаются.
  revokedAt  DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_accounts")
}
