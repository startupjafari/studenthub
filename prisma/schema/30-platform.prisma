// Состояние платформы: рычаги, которыми админ управляет вебом, не выкатывая деплой
// (режим техработ, баннер-объявление, погашенные разделы, объявленный релиз).
//
// Почему таблица, а не только Redis. Redis здесь кэш, но не источник правды: его
// перезапуск на Railway молча снял бы режим техработ и потерял объявление. Состояние,
// которое переживает падение процесса, обязано лежать в БД.
//
// Почему строка одна. Настройки глобальные, на всю платформу; вузовских рычагов здесь
// нет намеренно — иначе у каждого вуза появилась бы своя кнопка «выключить чаты», и
// платформа перестала бы быть одним продуктом. Единственность держит сервис: он всегда
// пишет и читает `id = "singleton"` через upsert.

model PlatformState {
  id String @id @default("singleton")

  // ── Режим техработ ───────────────────────────────────────────────────────────
  // Хранится СРОКОМ, а не флагом: «включено до 14:30», а не «включено».
  // Это и есть автоотпуск — режим кончается сам, потому что кончается время, и для
  // этого не нужны ни cron, ни память человека. Забытый выключатель, гасящий продукт
  // до утра, — самый вероятный способ уронить платформу этой функцией; способ не
  // забыть его — не дать выразить состояние «навсегда».
  // null или прошедшее время = режим выключен.
  maintenanceUntil     DateTime? @map("maintenance_until")
  maintenanceMessageRu String?   @map("maintenance_message_ru")
  maintenanceMessageKk String?   @map("maintenance_message_kk")
  maintenanceMessageEn String?   @map("maintenance_message_en")

  // ── Баннер-объявление ────────────────────────────────────────────────────────
  // Тем же сроком и по той же причине: объявление о вчерашнем обновлении, висящее
  // неделю, читатели перестают видеть — и не увидят следующее, настоящее.
  bannerUntil  DateTime? @map("banner_until")
  bannerTextRu String?   @map("banner_text_ru")
  bannerTextKk String?   @map("banner_text_kk")
  bannerTextEn String?   @map("banner_text_en")
  /// INFO | WARNING — тон баннера. Строкой, как visibility у контента.
  bannerLevel  String?   @map("banner_level")

  // ── Погашенные разделы ───────────────────────────────────────────────────────
  // Список выключенного, а не набор флагов «включено»: пустой массив = всё работает,
  // и новый раздел платформы по умолчанию жив, без миграции и без правки дефолтов.
  disabledSections String[] @default([]) @map("disabled_sections")

  // ── Объявленный релиз ────────────────────────────────────────────────────────
  // Только НОМЕР версии. Текст ноты остаётся в бандле web вместе с кодом, который
  // описывает (см. 28-releases.prisma): у PWA с домашнего экрана вкладка неделями
  // живёт на старой сборке, и текст, прилетевший из API раньше бандла, рассказывал бы
  // про кнопки, которых у человека ещё нет. Здесь хранится ответ на другой вопрос —
  // «какую версию уже объявили», — и веб показывает ноту, только если её версия не
  // выше его собственной сборки.
  announcedVersion String? @map("announced_version")

  // ── Уведомления команде платформы ────────────────────────────────────────────
  // Часы тишины по времени сервера, включительно-исключительно: [quiet_from, quiet_to).
  // Жалоба в три ночи будит того, кто всё равно разберёт её утром, — и следующую,
  // дневную и настоящую, он уже прочитает вполглаза.
  //
  // Оба поля NULL = тишины нет. Интервал может переходить через полночь (22 → 8) —
  // именно так его обычно и задают, поэтому сравнение не «от и до», а «вне окна».
  quietFrom Int? @map("quiet_from")
  quietTo   Int? @map("quiet_to")

  /// Виды уведомлений, которые НЕ слать: 'complaint' | 'ticket' | 'reply'.
  /// Список выключенного, а не включённого: новый вид уведомления по умолчанию доходит.
  mutedNotifications String[] @default([]) @map("muted_notifications")

  /// Дежурный: когда задан, уведомления уходят только ему. Сообщение всей команде
  /// означает, что не среагирует никто — каждый решит, что возьмёт другой.
  dutyUserId String? @map("duty_user_id")

  /// Час ежедневной сводки по времени сервера. NULL — сводку не слать.
  digestHour Int? @map("digest_hour")

  // Кто и когда трогал рычаги. Подробности — в AuditLog; здесь для быстрого ответа
  // на вопрос «кто включил техработы», не поднимая журнал.
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_state")
}
