// Домен «Камеры» (docs/PROJECT.md §3.10): просмотр камер вуза охраной и админом вуза.
//
// Видео через базу не идёт и нигде не хранится — здесь только устройства и доступ:
//
// 1. CameraAgent — программа в сети вуза. Сама ходит наружу, к платформе (входящих портов
//    в сети вуза не открывают). В базе — только SHA-256 её токена: сам токен показывается
//    админу один раз. `publicKey` — открытый ключ X25519 агента: им шифруются пароли камер,
//    а закрытый ключ есть только у агента.
// 2. Camera — камера за агентом. Адрес потока хранится без логина и пароля; учётные данные
//    лежат отдельно, зашифрованными ключом агента (`credentialsSealed`). Утечка базы не
//    раскрывает пароли камер: расшифровать их платформа не может сама.
// 3. CameraSettings — выключатель модуля на вуз. По умолчанию камеры ВЫКЛЮЧЕНЫ: вуз
//    включает их сам, и тем же выключателем всё гасит разом.

model CameraAgent {
  id           String    @id @default(uuid())
  universityId String    @map("university_id")
  name         String
  tokenHash    String    @unique @map("token_hash")
  // Открытый ключ X25519 (base64url, 32 байта). Пусто — агент ещё ни разу не выходил на
  // связь, и камерам с паролем его пока нечем зашифровать.
  publicKey    String?   @map("public_key")
  version      String?
  lastSeenAt   DateTime? @map("last_seen_at")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy  User?      @relation("CameraAgentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  cameras    Camera[]

  @@index([universityId])
  @@index([createdById])
  @@map("camera_agents")
}

model Camera {
  id                String       @id @default(uuid())
  universityId      String       @map("university_id")
  agentId           String       @map("agent_id")
  // Где висит: охране так быстрее найти нужную камеру. Помещение удалили — камера остаётся.
  roomId            String?      @map("room_id")
  name              String
  // Адрес потока в сети вуза БЕЗ логина и пароля: rtsp://10.0.0.5:554/Streaming/Channels/102.
  streamUrl         String       @map("stream_url")
  // Логин и пароль камеры, зашифрованные открытым ключом агента. Пусто — камера без пароля.
  credentialsSealed String?      @map("credentials_sealed")
  enabled           Boolean      @default(true)
  status            CameraStatus @default(UNKNOWN)
  lastSeenAt        DateTime?    @map("last_seen_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  university University  @relation(fields: [universityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  agent      CameraAgent @relation(fields: [agentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  room       Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([universityId])
  @@index([agentId])
  @@index([roomId])
  @@map("cameras")
}

model CameraSettings {
  universityId String   @id @map("university_id")
  enabled      Boolean  @default(false)
  updatedById  String?  @map("updated_by_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedBy  User?      @relation("CameraSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([updatedById])
  @@map("camera_settings")
}
