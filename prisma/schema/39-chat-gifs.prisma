// «Мои GIF» как в Telegram (docs/PROJECT.md §8, «GIF»): GIF, сохранённые пользователем из
// переписки одним касанием. До 200 штук, свежие сверху; сверх лимита вытесняется самый старый.
//
// У сохранённого своя запись File — на тот же объект хранилища, что у вложения-источника,
// без копирования байтов (пара bucket/key не уникальна, см. 08-files.prisma). Поэтому GIF
// остаётся у человека, даже когда сообщение-источник удалили или он вышел из чата, а
// отправка из «Моих GIF» — обычная копия файла (`POST /chats/:id/gif`), без повторной загрузки.
model SavedGif {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  // Своя запись File (бакет чатов, без сообщения). Удалили запись — уходит и сохранённый.
  fileId       String   @unique @map("file_id")
  // Вложение, из которого сохранили. Без FK: источник может исчезнуть, а сохранённый —
  // остаться. Нужен клиенту, чтобы в меню сообщения показать «Убрать из GIF».
  sourceFileId String?  @map("source_file_id")
  // Отпечаток содержимого источника `<size>:<width>:<height>` — по нему склеиваются копии
  // одного GIF (каждая пересылка — новая запись File) и клиент узнаёт «уже сохранён».
  fingerprint  String
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Выдача «свежие сверху» и поиск самого старого для вытеснения.
  @@index([userId, createdAt])
  // Повторное сохранение того же GIF поднимает существующую запись, а не плодит новую.
  @@index([userId, fingerprint])
  @@map("saved_gifs")
}
