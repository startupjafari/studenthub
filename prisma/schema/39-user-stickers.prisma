// Свои стикеры (docs/PROJECT.md «Свои стикеры»): личные наборы лежат в StickerSet (kind USER),
// здесь — какие личные наборы человек добавил себе в панель (свои и чужие по ссылке).
// Каталог платформы сюда не пишется: он в панели у всех.

/// Набор, добавленный пользователем в панель стикеров. Свой набор добавляется сам при
/// создании; чужой — кнопкой «Добавить» на странице ссылки. Набор удалили или сняли
/// модерацией — строка остаётся, но в выдачу не попадает.
model UserStickerSet {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  setId     String   @map("set_id")
  // Порядок в панели: свежедобавленный — сверху (как в Telegram).
  createdAt DateTime @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  set  StickerSet @relation(fields: [setId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, setId])
  @@index([userId, createdAt])
  @@index([setId])
  @@map("user_sticker_sets")
}
