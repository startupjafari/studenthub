// Базовая конфигурация Prisma. Multi-file схема: prisma/schema/*.prisma.
// datasource + generator живут здесь; enum'ы — в _enums.prisma; модели — в NN-<domain>.prisma.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
