// Все перечисления платформы. Источник истины — docs/PROJECT.md §6.1.
// Определяются один раз здесь; модели ссылаются на них из NN-<domain>.prisma.

enum Role {
  PLATFORM_ADMIN
  PLATFORM_MODERATOR
  UNIVERSITY_ADMIN
  UNIVERSITY_MODERATOR
  DEAN
  TEACHER
  STAROSTA
  STUDENT
}

enum UniversityStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum InviteStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

enum PostAudience {
  ALL
  UNIVERSITY
  FACULTY
  GROUP
  SUBJECT
  TEACHERS
  PERSONAL
}

enum ChatType {
  PRIVATE
  GROUP
  GROUP_OFFICIAL
  SUBJECT
  FACULTY
  DEAN
  SUPPORT
  EVENT
  // «Сохранённые» (§15): личный self-chat пользователя (единственный участник — он сам).
  SAVED
}

enum WeekType {
  ODD
  EVEN
  BOTH
}

// Назначение помещения (Ф16 «QR кабинета»). От него зависит, что показывать по QR:
// у учебных помещений — текущая пара из расписания, у остальных — часы работы и контакт.
enum RoomKind {
  // Учебные: занятия приходят из расписания (Pair.roomId).
  AUDITORIUM
  LAB
  SPORT_HALL
  // Неучебные: расписания пар нет, показываем часы работы/телефон/описание.
  LIBRARY
  ASSEMBLY_HALL
  ADMIN_OFFICE
  DEAN_OFFICE
  ACCOUNTING
  CANTEEN
  DORMITORY
  OTHER
}

enum NotificationType {
  SCHEDULE_CHANGE
  APP_UPDATE
  MESSAGE
  POST
  EVENT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum ScheduleChangeType {
  MOVED
  ROOM_CHANGED
  CANCELLED
  SUBSTITUTED
}

enum ComplaintTargetType {
  POST
  STORY
  COMMENT
  MESSAGE
  USER
}

// Приоритет жалобы в очереди модерации. Определяется категорией цели (см.
// complaintPriorityFor в packages/shared-schemas): жалобы на человека и на личные
// сообщения разбираются первыми. Порядок значений = порядок разбора: ORDER BY priority ASC
// в Postgres идёт по порядку объявления, поэтому HIGH объявлен первым.
enum ComplaintPriority {
  HIGH
  MEDIUM
  LOW
}

enum ComplaintStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// Симметричная дружба (ВК-стиль): заявка → принятие. Блокировка — отдельная модель UserBlock.
enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Вид объекта КАТО. Официальные поля выгрузки (`Level`, `AreaType`) для этого непригодны:
// районы встречаются сразу в двух типах, а зимовки лежат на уровне областей. Вид выводится
// из названия генератором `scripts/gen-kato.mjs`.
// REGION/DISTRICT/ADMIN — административные уровни (нужны для подписи «город, область»
// и фильтров), остальные — населённые пункты.
enum KatoKind {
  REGION
  DISTRICT
  ADMIN
  CITY
  SETTLEMENT
  VILLAGE
  STATION
  OTHER
}
