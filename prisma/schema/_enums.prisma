// Все перечисления платформы. Источник истины — docs/PROJECT.md §6.1.
// Определяются один раз здесь; модели ссылаются на них из NN-<domain>.prisma.

enum Role {
  PLATFORM_ADMIN
  PLATFORM_MODERATOR
  UNIVERSITY_ADMIN
  UNIVERSITY_MODERATOR
  DEAN
  TEACHER
  STAROSTA
  STUDENT
  // Работодатель (Фаза 18). Единственная роль вне вуза: скоуп у неё не universityId,
  // а компания, и доступ к студентам считается по CompanyUniversityAccess.
  EMPLOYER
  // Охрана одного вуза: сканер QR, проверка студенческого, помещения, камеры. Выдаёт
  // UNIVERSITY_ADMIN, 2FA обязательна, всё вне явного списка маршрутов закрыто
  // (docs/PROJECT.md §2).
  SECURITY_GUARD
  // Библиотекарь одного вуза (Фаза 20): каталог, выдача и возврат книг. Выдаёт
  // UNIVERSITY_ADMIN, 2FA обязательна, всё вне явного списка маршрутов закрыто — как у охраны.
  LIBRARIAN
}

enum UniversityStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum InviteStatus {
  PENDING
  USED
  EXPIRED
  REVOKED
}

// Заявка вуза на тестирование платформы (docs/PROJECT.md §31).
// Состояния идут в одну сторону: PENDING_EMAIL → NEW → APPROVED | REJECTED.
//
// PENDING_EMAIL отделён от NEW намеренно: в очередь модерации попадают только заявки
// с подтверждённым адресом. Форма публичная, и без этого шага очередь набивается
// заявками, поданными с чужих адресов, — разбирать их пришлось бы человеку.
enum DemoRequestStatus {
  PENDING_EMAIL
  NEW
  APPROVED
  REJECTED
}

// Причина отказа — из закрытого списка, а не свободным текстом.
// Свободный текст неизбежно превращается в переписку, которая уходит в почту мимо
// журнала, а заявитель всё равно отвечает письмом. Список причин отвечает на
// единственный вопрос, который у него есть: «можно ли прийти снова и когда».
enum DemoRejectionReason {
  // Не вуз: школа, курсы, частное лицо.
  NOT_ELIGIBLE
  // Заявка уже есть — от этого же вуза, другим контактом.
  DUPLICATE
  // Данных не хватает, чтобы понять, кто подал: можно подать заново.
  INSUFFICIENT_INFO
  // Мест на тестирование сейчас нет: можно вернуться позже.
  NO_CAPACITY
  OTHER
}

enum PostAudience {
  ALL
  UNIVERSITY
  FACULTY
  GROUP
  SUBJECT
  TEACHERS
  PERSONAL
}

// Аудитория сторис (docs/PROJECT.md §3.4). Отдельный enum, а не PostAudience: у сторис
// нет ни личной (PERSONAL), ни предметной (SUBJECT) аудитории — формат публичный и
// короткоживущий, адресное сообщение одному человеку — это чат, а не сторис.
enum StoryAudience {
  ALL
  UNIVERSITY
  FACULTY
  GROUP
  TEACHERS
}

enum ChatType {
  PRIVATE
  GROUP
  GROUP_OFFICIAL
  SUBJECT
  FACULTY
  DEAN
  SUPPORT
  /// Обращение в поддержку ПЛАТФОРМЫ: приватная переписка автора с командой платформы.
  /// Отличается от SUPPORT принципиально — тот общая комната вуза, где состоят все.
  SUPPORT_PLATFORM
  EVENT
  // «Сохранённые» (§15): личный self-chat пользователя (единственный участник — он сам).
  SAVED
}

enum WeekType {
  ODD
  EVEN
  BOTH
}

// Назначение помещения (Ф16 «QR кабинета»). От него зависит, что показывать по QR:
// у учебных помещений — текущая пара из расписания, у остальных — часы работы и контакт.
enum RoomKind {
  // Учебные: занятия приходят из расписания (Pair.roomId).
  AUDITORIUM
  LAB
  SPORT_HALL
  // Неучебные: расписания пар нет, показываем часы работы/телефон/описание.
  LIBRARY
  ASSEMBLY_HALL
  ADMIN_OFFICE
  DEAN_OFFICE
  ACCOUNTING
  CANTEEN
  DORMITORY
  OTHER
}

enum NotificationType {
  SCHEDULE_CHANGE
  APP_UPDATE
  MESSAGE
  POST
  EVENT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum ScheduleChangeType {
  MOVED
  ROOM_CHANGED
  CANCELLED
  SUBSTITUTED
}

enum ComplaintTargetType {
  POST
  STORY
  COMMENT
  MESSAGE
  USER
}

// Приоритет жалобы в очереди модерации. Определяется категорией цели (см.
// complaintPriorityFor в packages/shared-schemas): жалобы на человека и на личные
// сообщения разбираются первыми. Порядок значений = порядок разбора: ORDER BY priority ASC
// в Postgres идёт по порядку объявления, поэтому HIGH объявлен первым.
enum ComplaintPriority {
  HIGH
  MEDIUM
  LOW
}

enum ComplaintStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// Симметричная дружба (ВК-стиль): заявка → принятие. Блокировка — отдельная модель UserBlock.
enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// Вид объекта КАТО. Официальные поля выгрузки (`Level`, `AreaType`) для этого непригодны:
// районы встречаются сразу в двух типах, а зимовки лежат на уровне областей. Вид выводится
// из названия генератором `scripts/gen-kato.mjs`.
// REGION/DISTRICT/ADMIN — административные уровни (нужны для подписи «город, область»
// и фильтров), остальные — населённые пункты.
enum KatoKind {
  REGION
  DISTRICT
  ADMIN
  CITY
  SETTLEMENT
  VILLAGE
  STATION
  OTHER
}

// Платформа устройства для пушей. По ней выбирается транспорт: IOS — APNs (план
// iOS, Задача Б1), ANDROID — FCM (план Android, Задача АБ1). Таблица у них общая.
enum DevicePlatform {
  IOS
  ANDROID
}

// Обработка медиа файла (единая медиа-система): варианты изображений, постер и HLS видео
// готовит воркер, HTTP-запрос не ждёт. NONE — файл не медиа или обработка ему не положена
// (документ, «отправить без сжатия»); клиент тогда показывает оригинал, как раньше.
enum MediaStatus {
  NONE
  PENDING
  PROCESSING
  READY
  FAILED
}

// Вид производного объекта медиа (`FileVariant`).
enum MediaVariantKind {
  // Уменьшенная WebP-копия изображения — элемент srcset.
  IMAGE
  // Кадр видео в WebP — постер плеера и превью в сетках.
  POSTER
  // Рендишн HLS: ключ указывает на его плейлист, сегменты лежат рядом.
  HLS
}

// Состояние камеры по последнему отчёту агента (docs/PROJECT.md §3.10). UNKNOWN — агент о
// камере ещё не сообщал; AUTH_FAILED — камера отвечает, но логин или пароль неверны:
// админу надо поправить учётные данные, а не искать камеру в сети.
enum CameraStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  AUTH_FAILED
}

// ── Библиотека (Фаза 20) ─────────────────────────────────────────────────────────────

// Экземпляр книги. RESERVED — отложен под готовую бронь; LOST и WRITTEN_OFF из оборота
// выведены, но история выдач у них остаётся.
enum BookCopyStatus {
  AVAILABLE
  RESERVED
  ON_LOAN
  LOST
  WRITTEN_OFF
}

// Состояние экземпляра: отмечается при заведении и при возврате.
enum BookCondition {
  GOOD
  WORN
  DAMAGED
}

// Выдача. «Просрочена» не хранится — это OPEN с прошедшим dueAt. CANCELLED — ошибочная
// выдача, отменённая библиотекарем (выдачи не правятся задним числом).
enum LoanStatus {
  OPEN
  RETURNED
  LOST
  CANCELLED
}

// Бронь на книгу: QUEUED → READY (экземпляр отложен) → FULFILLED (выдан по брони).
enum ReservationStatus {
  QUEUED
  READY
  FULFILLED
  CANCELLED
  EXPIRED
}
